[Unit]
Description=paper2md — PDF to Markdown web service
Documentation=https://github.com/<you>/paper2md
After=network-online.target

[Service]
Type=simple
# === 按实际部署改这三行 ===
User=YOUR_USER
WorkingDirectory=/opt/paper2md
ExecStart=/opt/paper2md/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8300

# === 引擎与数据 ===
Environment=OT_ENGINE=MinerU
Environment=OT_PORT=8300
Environment=OT_DATA_DIR=/var/lib/paper2md
Environment=OT_MINERU_MODEL_SOURCE=modelscope
Environment=OT_MINERU_PYTHON=/home/YOUR_USER/.venvs/mineru/bin/python
Environment=OT_MINERU_BIN=/home/YOUR_USER/.venvs/mineru/bin/mineru

Restart=always
RestartSec=3
# 转换是子进程,停服务时一起收掉
KillMode=mixed
TimeoutStopSec=20
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
